{
  "name": "incentive-router",
  "version": "0.2.0",
  "private": true,
  "description": "Incentive farming router: generalized loop-farm risk framework, cross-chain funding, live adapters (Sui + EVM).",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --import tsx --test packages/*/test/*.test.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "scan": "tsx packages/core/src/cli.ts scan",
    "plan": "tsx packages/core/src/cli.ts plan",
    "sim": "tsx packages/core/src/cli.ts sim",
    "run:paper": "tsx packages/core/src/cli.ts run --paper",
    "live": "tsx packages/live-runner/src/cli.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "@cetusprotocol/aggregator-sdk": {
      "@mysten/sui": "2.38.0"
    }
  }
}
