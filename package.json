{
  "name": "incentive-router",
  "version": "0.1.0",
  "private": true,
  "description": "Generalized risk framework for incentive farming (lending loops, LP incentives, delta-neutral perp points) — generalized from the loop-farm core.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "scan": "tsx src/cli.ts scan",
    "plan": "tsx src/cli.ts plan",
    "sim": "tsx src/cli.ts sim",
    "run:paper": "tsx src/cli.ts run --paper"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
