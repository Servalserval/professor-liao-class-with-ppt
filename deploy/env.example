# /etc/incentive-router/env  (chmod 600, owner incentive)
# Secrets live in files, never in config/live.yaml.
EVM_PRIVATE_KEY_FILE=/etc/incentive-router/evm.key
SUI_PRIVATE_KEY_FILE=/etc/incentive-router/sui.key
# Wallet addresses (shadow mode can run with these alone, no keys; with keys they must match)
EVM_ADDRESS=
SUI_ADDRESS=

# Paid RPC endpoints (referenced from config/live.yaml as ${VAR})
RPC_ETHEREUM=
RPC_ARBITRUM=
RPC_BASE=
RPC_PLASMA=
RPC_MONAD=
RPC_AVALANCHE=
RPC_MANTLE=
SUI_GRPC=
SUI_JSONRPC=

# Pyth Hermes (Suilend / Scallop push prices inside the PTB; the hosted endpoint needs a token)
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_API_KEY=

# Optional
MERKL_API_KEY=
CETUS_API_KEY=
TG_BOT_TOKEN=
TG_CHAT_ID=

# Uncomment ONLY when going live (with mode: live in config and a fresh verify stamp)
# LIVE_CONFIRM=yes
